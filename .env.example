# Public site URL (no trailing slash). Used for Stripe redirects and sign-in links.
NEXT_PUBLIC_SITE_URL=https://alliance.yorcmo.com

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe recurring Price IDs (price_...). Leave an add-on blank to show "Coming soon".
STRIPE_PRICE_MEMBERSHIP=
STRIPE_PRICE_CORE_WHOLESALE=
STRIPE_PRICE_BACK_OFFICE=
STRIPE_PRICE_CONCIERGE=
